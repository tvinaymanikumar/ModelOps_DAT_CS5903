# Copy to .env and fill in. Never commit .env.

# ---- Privacy -------------------------------------------------------------
# External (hosted) APIs such as Gemini are hidden unless this is true.
ALLOW_EXTERNAL_MODELS=false

# ---- Qwen2.5-VL-7B (team endpoint, OpenAI-compatible) ----------------------
QWEN_BASE_URL=http://10.68.0.39:9005/v1
QWEN_MODEL_NAME=qwen2.5-vl-7b

# ---- NuExtract3 (team endpoint, OpenAI-compatible) -------------------------
NUEXTRACT_BASE_URL=http://10.68.0.39:9003/v1
NUEXTRACT_MODEL_NAME=nuextract3
# true = reasoning mode (slower, for hard documents)
NUEXTRACT_ENABLE_THINKING=false

# ---- GLM-4.6V-Flash (team endpoint, OpenAI-compatible) ---------------------
GLM_BASE_URL=http://10.68.0.39:9007/v1
GLM_MODEL_NAME=glm-4.6v-flash
# vLLM turns GLM thinking on by default; the app switches it off unless true
GLM_ENABLE_THINKING=false

# Images are shrunk to this longest side and sent as JPEG
MAX_IMAGE_SIDE=1600

# ---- Gemini (optional, EXTERNAL) -------------------------------------------
# Also needs ALLOW_EXTERNAL_MODELS=true to appear in the model list
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.5-flash

# ---- General -----------------------------------------------------------------
REQUEST_TIMEOUT_S=180
PDF_DPI=200
LOG_LEVEL=INFO
# Optional TTF font for PDF reports (non-ASCII text)
PDF_FONT_PATH=
